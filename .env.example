# --- GLM Vision OCR engine ---
# Anthropic-compatible endpoint of the GLM coding plan.
# GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
# GLM_MODEL=GLM-5.3-Flash
# GLM_DPI=200
# GLM_CONCURRENCY=6
# GLM_MAX_TOKENS=16000
# Page transcription disables model "thinking" for ~5x speed at identical
# quality; set to "enabled" to restore deep reasoning.
# GLM_THINKING=disabled

# API key for the GLM engine. If empty, the tool falls back to reading the
# local ZCode coding-plan config (~/.zcode/v2/config.json — any
# Anthropic-compatible provider with a key, coding-plan preferred).
# GLM_API_KEY=your_glm_api_key_here
